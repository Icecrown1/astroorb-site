run = "npm run dev"
entrypoint = "app/page.tsx"
modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[deployment]
build = ["sh", "-c", "npm run build"]
run = ["sh", "-c", "npm run start"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 26070
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AstroOrb"

[[workflows.workflow]]
name = "AstroOrb"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- -p 5000"

[userenv]

[userenv.shared]
NEXT_PUBLIC_SITE_URL = "https://astroorbi.com"
NEXT_PUBLIC_BOT_USERNAME = "AstroOrbI_Bot"
HOROSCOPE_API_URL = "https://astro-orb-chat.replit.app"
NEXT_PUBLIC_YM_ID = "111833052"
NEXT_PUBLIC_GA_ID = "G-ELRV9N7RJ3"
